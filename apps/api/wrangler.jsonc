{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parsejudge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "enabled": true }, "traces": { "enabled": true } },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["17 * * * *"] },
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "parsejudge_usage" }],
  "limits": { "cpu_ms": 300000 },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/blobs/*", "/openapi.json", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"]
  },
  "ratelimits": [
    { "name": "TITLE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_URL": "http://localhost:8787",
    "JUDGE_MODEL": "gpt-6.1-sol",
    "JUDGE_FALLBACK_MODELS": "gpt-5.5,gpt-5.2",
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_AUTH_URL": "https://auth.openai.com/oauth/token",
    // OpenAI project "ParseJudge": OIDC workload identity provider, the service account it maps to, and the JWT claims it trusts.
    "OPENAI_IDENTITY_PROVIDER_ID": "idp_9d5b7f2bf4d257c6ebd41dd8",
    "OPENAI_SERVICE_ACCOUNT_ID": "user-0eaf0a6824553c5f307e1ab8",
    "OPENAI_JWT_ISSUER": "https://parsejudge.com",
    "OPENAI_JWT_AUDIENCE": "https://api.openai.com/v1",
    "OPENAI_JWT_SUBJECT": "spiffe://parsejudge.com/worker/judge",
    "SMALL_MODEL": "gpt-6-luna",
    "JUDGE_REASONING_EFFORT": "medium",
    "MAX_PAGES_PER_RUN": "1000",
    "MAX_PAGES_PER_DAY": "10000",
    "MAX_UPLOAD_BYTES": "268435456",
    "MAX_CONCURRENCY": "{}",
    "AWS_REGION": "us-west-2",
    "AUTH_MODE": "email",
    "EMAIL_FROM": "noreply@parsejudge.com"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local" }],
  "d1_databases": [{ "binding": "DB", "database_name": "parsejudge", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "parsejudge-blobs" }],
  "durable_objects": {
    "bindings": [
      { "name": "RUN_EVENTS", "class_name": "RunEvents" },
      { "name": "PROVIDER_SLOTS", "class_name": "ProviderSlots" },
      { "name": "CONVERTER", "class_name": "Converter" },
      { "name": "SPLITTER", "class_name": "Splitter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunEvents", "ProviderSlots", "Converter"] },
    { "tag": "v2", "new_sqlite_classes": ["Splitter"] }
  ],
  // DOCX/PPTX -> PDF. parsejudge.com points `image` at a private image instead.
  "containers": [
    {
      "class_name": "Converter",
      "image": "../../containers/libreoffice/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 4
    },
    // Splits PDFs too large for the Worker's memory.
    {
      "class_name": "Splitter",
      "image": "../../containers/splitter/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 4
    }
  ],
  "workflows": [
    { "name": "parsejudge-run", "binding": "RUN_WORKFLOW", "class_name": "RunWorkflow" },
    { "name": "parsejudge-page", "binding": "PAGE_WORKFLOW", "class_name": "PageWorkflow" },
    { "name": "parsejudge-document", "binding": "DOCUMENT_WORKFLOW", "class_name": "DocumentWorkflow" }
  ]
}
