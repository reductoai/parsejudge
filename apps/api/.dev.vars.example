AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
COHERE_API_KEY=
DATALAB_API_KEY=
EXTEND_API_KEY=
LLAMA_CLOUD_API_KEY=
MISTRAL_API_KEY=
NUTRIENT_API_KEY=
PULSE_API_KEY=
REDUCTO_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Service account key JSON (one line) with roles/documentai.apiUser, and the Layout Parser processor name.
GOOGLE_DOCAI_CREDENTIALS=
GOOGLE_DOCAI_PROCESSOR=projects/<project>/locations/us/processors/<id>
# Private P-256 JWK (JSON, with kid) for OpenAI OIDC workload identity.
OPENAI_SIGNING_KEY=
# Required. 32 bytes, base64: openssl rand -base64 32
BLOB_SIGNING_KEY=
CREDENTIALS_KEY=
# Required. At least 32 characters: openssl rand -base64 32
AUTH_KEY=
# Local only: also trust the x-parsejudge-user header.
AUTH_MODE=dev
